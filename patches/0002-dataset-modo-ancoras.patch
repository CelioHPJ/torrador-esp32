+def selecionar_por_ancora(linhas, ancoras, janela):
+    """Modo 'ancoras': NAO inventa rotulo nenhum.
+
+    Devolve so os frames que caem dentro de +-janela segundos de uma marcacao
+    manual, rotulados com o Agtron daquela marcacao. Frames longe de qualquer
+    ancora sao descartados em vez de receberem um valor interpolado.
+
+    Por que isto existe: a interpolacao linear assume que o grao escurece em
+    linha reta no tempo entre duas marcacoes, o que nao acontece -- o
+    escurecimento acelera. Com 2 ancoras, um CSV de 5000 linhas interpoladas
+    nao carrega 5000 observacoes; carrega 2 observacoes e muito preenchimento,
+    e um R^2 alto contra esses alvos mede o quao bem a cor reproduz a reta
+    inventada, nao a torra.
+
+    NOTA: nao ha aqui um modo com curva exponencial de proposito. Trocar a reta
+    por uma curva escolhida a dedo substituiria um chute por outro chute de
+    aparencia mais sofisticada. Enquanto nao houver Agtron medido, o unico
+    caminho honesto e treinar so onde existe observacao.
+    """
+    saida = []
+    for linha in linhas:
+        t = float(linha['timestamp'])
+        for ts, agtron, _fase in ancoras:
+            if abs(t - ts) <= janela:
+                saida.append((linha, agtron))
+                break
+    return saida
+
+
